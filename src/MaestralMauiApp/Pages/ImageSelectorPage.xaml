<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MaestralMauiApp.PageModels"
             xmlns:controls="clr-namespace:MaestralMauiApp.Pages.Controls"
             x:Class="MaestralMauiApp.Pages.ImageSelectorPage"
             x:DataType="pageModels:ImageSelectorPageModel"
             Title="Select Image">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Image Aspect="AspectFit"
               HeightRequest="250"
               Source="{Binding SelectedImage}" />
        <Button Text="Select Image"
                Command="{Binding SelectImageCommand}" />

        <controls:AddButton
            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
            Command="{Binding TextRecognitionCommand}" />

        <controls:AddButton
            IsEnabled="true"
            Command="{Binding TextRecognitionCommand}" />
    </VerticalStackLayout>
</ContentPage>
