<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MaestralMauiApp.PageModels"
             x:Class="MaestralMauiApp.Pages.TextRecognitionImagePage"
             x:DataType="pageModels:TextRecognitionImagePageModel"
             Title="Text Recognition Image">
    <VerticalStackLayout Spacing="24" Padding="24">
        <Image Source="{Binding SelectedImage}" HeightRequest="300" Aspect="AspectFit" />
        <Button Text="Pick Image" Command="{Binding SelectImageCommand}" />
    </VerticalStackLayout>
</ContentPage>
